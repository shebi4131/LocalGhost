@inherits LayoutComponentBase

<main class="auth-shell">
    <section class="auth-panel">
        <a class="auth-brand" href="/">
            <span class="auth-logo"><img src="/localghost-logo-transparent.png" alt="" width="32" height="32" /></span>
            <span>
                <strong>LocalGhost</strong>
                <small>CI/CD made quietly powerful</small>
            </span>
        </a>

        @Body

        <p class="auth-footer">Secure access to your deployment workspace</p>
    </section>
    <aside class="auth-aside">
        <div class="auth-visual">
            <span class="eyebrow">DEPLOY WITH CONFIDENCE</span>
            <h2>Your pipeline.<br />Always in sight.</h2>
            <p>Follow commits from GitHub to IIS with real-time logs, automatic backups, and safe rollback.</p>
            <div class="mini-terminal">
                <div class="terminal-top"><i></i><i></i><i></i><span>localghost-agent</span></div>
                <div><b>✓</b> Source synchronized</div>
                <div><b>✓</b> Build completed</div>
                <div class="terminal-live"><b>●</b> Deployment live</div>
            </div>
        </div>
    </aside>
</main>

<style>
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; background: #0F1117; }
    .auth-shell { min-height: 100vh; display: grid; grid-template-columns: minmax(420px, .8fr) 1.2fr; color: #E2E8F0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    .auth-panel { display: flex; flex-direction: column; justify-content: center; width: min(100%, 470px); padding: 48px 64px; margin: auto; }
    .auth-brand { display: flex; align-items: center; gap: 11px; margin-bottom: 54px; color: inherit; text-decoration: none; }
    .auth-logo { width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid #34305B; border-radius: 12px; background: #1A1D2E; }
    .auth-logo img { width: 32px; height: 32px; object-fit: contain; }
    .auth-brand strong, .auth-brand small { display: block; }
    .auth-brand strong { color: #F8FAFC; font-size: 16px; }
    .auth-brand small { margin-top: 2px; color: #64748B; font-size: 10px; letter-spacing: .2px; }
    .auth-footer { margin: 40px 0 0; color: #475569; font-size: 11px; text-align: center; }
    .auth-aside { position: relative; display: grid; place-items: center; overflow: hidden; margin: 16px; border: 1px solid #292449; border-radius: 22px; background: radial-gradient(circle at 65% 25%, #33225F 0, #1A1830 35%, #12141E 75%); }
    .auth-aside::before { position: absolute; inset: 0; content: ''; opacity: .28; background-image: linear-gradient(#4C3F731f 1px, transparent 1px), linear-gradient(90deg, #4C3F731f 1px, transparent 1px); background-size: 34px 34px; }
    .auth-visual { position: relative; z-index: 1; width: min(520px, 75%); }
    .eyebrow { color: #A78BFA; font-size: 10px; font-weight: 700; letter-spacing: 1.8px; }
    .auth-visual h2 { margin: 18px 0; color: #F8FAFC; font-size: clamp(38px, 5vw, 64px); line-height: 1.02; letter-spacing: -2.5px; }
    .auth-visual > p { max-width: 470px; color: #8B95A8; font-size: 15px; line-height: 1.7; }
    .mini-terminal { margin-top: 42px; padding: 18px 20px 20px; border: 1px solid #373151; border-radius: 14px; background: #0B0D14dd; box-shadow: 0 30px 80px #0007; color: #8490A4; font: 12px/2 'Courier New', monospace; }
    .mini-terminal b { margin-right: 8px; color: #34D399; }
    .terminal-top { display: flex; align-items: center; gap: 6px; margin: -2px 0 13px; padding-bottom: 11px; border-bottom: 1px solid #24283A; }
    .terminal-top i { width: 7px; height: 7px; border-radius: 50%; background: #353A4D; }
    .terminal-top span { margin-left: 7px; color: #4F586C; font-size: 10px; }
    .terminal-live { color: #CBD5E1; }
    @@media (max-width: 850px) { .auth-shell { display: block; } .auth-panel { min-height: 100vh; padding: 36px 28px; } .auth-aside { display: none; } }
</style>
