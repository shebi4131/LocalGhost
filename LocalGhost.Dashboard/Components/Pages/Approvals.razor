@page "/approvals"
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationState
@inject UserManager<IdentityUser> Users
@inject DeploymentApprovalService ApprovalService
@inject ProjectAccessService Access
@using LocalGhost.Dashboard.Data

<PageTitle>Approvals · LocalGhost</PageTitle>

<div class="approval-head"><div><small>RELEASE CONTROL</small><h1>Deployment approvals</h1><p>Review the exact commit and environment before allowing a protected pipeline to run.</p></div><span>@_requests.Count pending</span></div>
@if (!string.IsNullOrWhiteSpace(Decided)) { <div class="approval-message">Deployment @Decided.</div> }
@if (_requests.Count == 0)
{
    <div class="approval-empty"><span>✓</span><h2>Nothing waiting for approval</h2><p>Protected environments will place new commits here before deployment.</p></div>
}
else
{
    <div class="approval-list">
        @foreach (var request in _requests)
        {
            <article><div class="approval-icon">◈</div><div class="approval-info"><h2>@request.ProjectName <span>/ @request.Environment</span></h2><p><code>@request.CommitSha[..Math.Min(7, request.CommitSha.Length)]</code> on <strong>@request.Branch</strong> · requested @request.RequestedAt.ToLocalTime().ToString("dd MMM, h:mm tt")</p><a href="/projects/@request.ProjectId">View project pipeline →</a></div>
                @if (_manageable.Contains(request.ProjectId))
                {
                    <div class="approval-actions"><form method="post" action="/approvals/@request.Id/decision"><AntiforgeryToken /><input type="hidden" name="decision" value="reject" /><button class="reject" type="submit">Reject</button></form><form method="post" action="/approvals/@request.Id/decision"><AntiforgeryToken /><input type="hidden" name="decision" value="approve" /><button class="approve" type="submit">Approve &amp; deploy</button></form></div>
                }
                else { <span class="approval-waiting">Waiting for a manager</span> }
            </article>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "decided")] public string? Decided { get; set; }
    private List<ApprovalView> _requests = [];
    private HashSet<Guid> _manageable = [];
    protected override async Task OnInitializedAsync()
    {
        var userId = Users.GetUserId((await AuthenticationState.GetAuthenticationStateAsync()).User);
        if (userId is null) return;
        _requests = await ApprovalService.GetPendingAsync(userId);
        foreach (var projectId in _requests.Select(x => x.ProjectId).Distinct())
            if (await Access.CanAsync(userId, projectId, ProjectMemberRole.Manager)) _manageable.Add(projectId);
    }
}

<style>
    .approval-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:25px}.approval-head small{color:#b59af2;font-size:9px;font-weight:800;letter-spacing:1.4px}.approval-head h1{margin:7px 0;color:#f1f5f9;font-size:26px}.approval-head p{margin:0;color:#9ba9bc;font-size:12px}.approval-head>span{padding:7px 11px;border:1px solid #534372;border-radius:20px;color:#d4c4f7;font-size:11px}.approval-message{padding:13px 16px;margin-bottom:15px;border:1px solid #26634f;border-radius:9px;background:#142a24;color:#79e5bb;font-size:11px}.approval-empty{padding:65px 22px;border:1px solid #30354a;border-radius:15px;background:#171b29;text-align:center}.approval-empty>span{display:inline-grid;place-items:center;width:43px;height:43px;border-radius:13px;background:#1b3b30;color:#6ee7b7;font-size:22px}.approval-empty h2{margin:16px 0 5px;color:#e8edf5;font-size:17px}.approval-empty p{margin:0;color:#9ca8ba;font-size:11px}.approval-list{display:grid;gap:12px}.approval-list article{display:flex;align-items:center;gap:15px;padding:18px;border:1px solid #383951;border-radius:13px;background:#191d2c}.approval-icon{display:grid;place-items:center;width:36px;height:36px;flex:none;border:1px solid #624c89;border-radius:9px;background:#312548;color:#ceb4ff}.approval-info{flex:1;min-width:0}.approval-info h2{margin:0 0 6px;color:#f0f2f8;font-size:14px}.approval-info h2 span{color:#b6a3df;font-weight:500}.approval-info p{margin:0;color:#a5b1c0;font-size:10px}.approval-info code{color:#bdaaff}.approval-info a{display:inline-block;margin-top:9px;color:#c2adf6;text-decoration:none;font-size:10px}.approval-actions{display:flex;gap:8px}.approval-actions button{padding:9px 12px;border:1px solid;border-radius:8px;cursor:pointer;font-size:10px;font-weight:700}.approval-actions .reject{border-color:#69404d;background:#2d2029;color:#f4a9b9}.approval-actions .approve{border-color:#704fc1;background:#7048d1;color:white}.approval-waiting{color:#9ca8bc;font-size:10px}@@media(max-width:700px){.approval-list article{align-items:flex-start;flex-wrap:wrap}.approval-actions{width:100%;justify-content:flex-end}}
</style>
