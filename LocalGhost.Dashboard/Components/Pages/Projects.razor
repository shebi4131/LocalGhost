@page "/projects"
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationState
@inject UserManager<IdentityUser> Users
@inject ProjectService ProjectsService

<PageTitle>Projects · LocalGhost</PageTitle>

<div class="projects-head">
    <div><div class="page-title">Projects</div><div class="page-sub">Every deployment pipeline, isolated and under control.</div></div>
    <a class="create-project" href="/projects/new"><span>＋</span> Add project</a>
</div>

@if (_projects.Count == 0)
{
    <section class="empty-projects">
        <div class="empty-orbit"><i></i><i></i><span><img src="/localghost-logo-transparent.png" alt="" width="48" height="48" /></span></div>
        <span class="empty-kicker">YOUR DEPLOYMENT WORKSPACE</span>
        <h1>Build your first pipeline.</h1>
        <p>Connect a GitHub repository, configure a Blazor Web App or .NET + React build, then deploy safely to IIS.</p>
        <a href="/projects/new"><span>＋</span> Create first project</a>
        <div class="empty-flow"><b><i class="cyan"></i>GitHub source</b><span>→</span><b><i class="amber"></i>Build pipeline</b><span>→</span><b><i class="green"></i>IIS deploy</b></div>
    </section>
}
else
{
    <div class="project-summary">
        <div><span class="dot violet"></span><small>Total projects</small><strong>@_projects.Select(x => x.ProjectGroupId).Distinct().Count()</strong></div>
        <div><span class="dot green"></span><small>Active environments</small><strong>@_projects.Count(x => x.IsActive)</strong></div>
        <div><span class="dot blue"></span><small>Deployments</small><strong>@_projects.Sum(x => x.DeploymentCount)</strong></div>
        <div><span class="dot amber"></span><small>Need attention</small><strong>@_projects.Count(x => x.LastDeploymentStatus == DeployStatus.Failed)</strong></div>
    </div>

    <div class="projects-grid">
        @foreach (var group in _projects.GroupBy(x => x.ProjectGroupId))
        {
            var project = group.OrderBy(x => x.CreatedAt).First();
            var latest = group.OrderByDescending(x => x.LastDeploymentAt).First();
            var runCount = group.Sum(x => x.DeploymentCount);
            var successRate = runCount == 0 ? 0 : group.Sum(x => x.DeploymentCount * x.SuccessRate) / runCount;
            <article class="project-card">
                <div class="project-card-top">
                    <div class="project-mark">@Initials(project.Name)</div>
                    <div class="project-name"><h2>@project.Name</h2><p>@group.Count() environment@(group.Count() == 1 ? "" : "s")</p></div>
                    <span class="project-state @(group.Any(x => x.IsActive) ? "active" : "paused")"><i></i>@(group.Any(x => x.IsActive) ? "Active" : "Paused")</span>
                </div>
                <p class="project-description">@(string.IsNullOrWhiteSpace(project.Description) ? "No description provided." : project.Description)</p>
                <div class="repo-line"><span>⑂</span><div><small>REPOSITORY</small><strong>@project.GitHub.RepoOwner/@project.GitHub.RepoName</strong></div><code>@project.GitHub.Branch</code></div>
                <div class="project-environments">@foreach (var environment in group.OrderBy(x => x.CreatedAt)){<a href="/projects/@environment.Id">@environment.Environment <span>@(environment.IsActive ? "●" : "○")</span></a>}</div>
                <div class="project-metrics">
                    <div><small>LAST DEPLOY</small><strong class="@StatusClass(latest.LastDeploymentStatus)">@(latest.LastDeploymentStatus?.ToString() ?? "Not deployed")</strong></div>
                    <div><small>SUCCESS RATE</small><strong>@(runCount == 0 ? "—" : $"{successRate}%")</strong></div>
                    <div><small>LAST COMMIT</small><strong class="sha">@(ShortSha(latest.LastSuccessfulCommitSha))</strong></div>
                </div>
                <div class="project-card-foot">
                    <span>@CommitDescription(latest)@if (!string.IsNullOrWhiteSpace(latest.LastSuccessfulCommitMessage)){<br /><b class="project-commit-message">@latest.LastSuccessfulCommitMessage.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()</b>}</span>
                    <a href="/projects/@project.Id/workspace">Manage project <b>→</b></a>
                </div>
            </article>
        }
    </div>
}

@code {
    private List<ProjectSummary> _projects = [];
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        var ownerId = Users.GetUserId(user);
        if (ownerId is not null) _projects = await ProjectsService.GetProjectsAsync(ownerId);
    }
    private static string Initials(string name) => string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private static string ShortSha(string? sha) => string.IsNullOrWhiteSpace(sha) ? "—" : sha[..Math.Min(7, sha.Length)];
    private static string CommitDescription(ProjectSummary project)
    {
        if (string.IsNullOrWhiteSpace(project.LastSuccessfulCommitSha)) return "Waiting for first successful deployment";
        var branch = project.LastSuccessfulBranch ?? project.GitHub.Branch.Split(',')[0];
        var committed = project.LastSuccessfulCommittedAt;
        var time = committed ?? project.LastSuccessfulDeploymentAt;
        var prefix = $"{ShortSha(project.LastSuccessfulCommitSha)} commit on {branch}";
        return time is null ? prefix : $"{prefix} · {(committed is null ? "deployed" : "committed")} at {time.Value.ToLocalTime():h:mm tt}";
    }
    private static string StatusClass(DeployStatus? status) => status switch { DeployStatus.Success => "success", DeployStatus.Failed => "failed", DeployStatus.Running => "running", _ => "" };
}

