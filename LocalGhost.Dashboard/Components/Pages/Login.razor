@page "/login"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Sign in · LocalGhost</PageTitle>

<div class="auth-heading">
    <h1>Welcome back</h1>
    <p>Sign in to manage your deployments.</p>
</div>

@if (Registered)
{
    <div class="auth-alert success" data-global-toast>Account created. You can sign in now.</div>
}
@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="auth-alert error" data-global-toast>@Error</div>
}

<form class="auth-form" method="post" action="/auth/login" onsubmit="return showAuthLoading(this)">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@ReturnUrl" />

    <label for="email">Email address</label>
    <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required autofocus />

    <div class="password-label">
        <label for="password">Password</label>
    </div>
    <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required />

    <label class="check-row">
        <input name="rememberMe" type="checkbox" />
        <span>Keep me signed in</span>
    </label>

    <button class="auth-submit" type="submit">
        <span class="button-label">Sign in</span>
        <span class="button-loading" hidden><i></i> Signing in...</span>
    </button>
</form>

<p class="auth-switch">New to LocalGhost? <a href="/register">Create an account</a></p>

@code {
    [SupplyParameterFromQuery(Name = "registered")]
    public bool Registered { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string ReturnUrl { get; set; } = "/dashboard";
}
