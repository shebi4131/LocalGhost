@page "/projects/{ProjectId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationState
@inject UserManager<IdentityUser> Users
@inject ProjectService ProjectsService
@inject DeployStateService DeployState
@inject ProjectPreflightService Preflight
@inject IJSRuntime JS

<PageTitle>@(_project?.Name ?? "Project") · LocalGhost</PageTitle>

@if (_project is null)
{
    <div class="missing-project"><span>?</span><h1>Project not found</h1><p>It may have been archived or belong to another account.</p><a href="/projects">Back to projects</a></div>
}
else
{
    <div class="project-detail-head">
        <div class="detail-identity"><a href="/projects">← Projects</a><div><span class="detail-mark">@Initials(_project.Name)</span><div><h1>@_project.Name</h1><p>@_project.GitHub.RepoOwner/@_project.GitHub.RepoName · @_project.GitHub.Branch</p></div></div></div>
        <div class="detail-actions">
            <details class="project-actions-menu">
                <summary aria-label="Project actions" title="Project actions"><span></span><span></span><span></span></summary>
                <div class="project-actions-popover">
                    <div class="actions-menu-head"><strong>Project actions</strong><small>Manage and run this pipeline</small></div>
                    <form method="post" action="/projects/@ProjectId/deploy"><AntiforgeryToken /><button class="menu-action primary" type="submit" disabled="@(!_project.IsActive || _current is not null)"><i>▶</i><span><b>@(_current is null ? "Deploy now" : "Deploying...")</b><small>Run the latest configured branch</small></span></button></form>
                    <button class="menu-action preflight-action" type="button" @onclick="RunPreflightAsync" disabled="@_preflightRunning"><i>@(_preflightRunning ? "…" : "◇")</i><span><b>@(_preflightRunning ? "Checking configuration..." : "Run preflight checks")</b><small>Validate source, build, IIS and permissions</small></span></button>
                    <a class="menu-action" href="/projects/@ProjectId/settings"><i>⚙</i><span><b>Project settings</b><small>Repository, build and IIS configuration</small></span><em>›</em></a>
                    <form method="post" action="/projects/@ProjectId/state"><AntiforgeryToken /><input type="hidden" name="active" value="@(!_project.IsActive ? "true" : "false")" /><button class="menu-action @(_project.IsActive ? "warning" : "success-action")" type="submit"><i>@(_project.IsActive ? "Ⅱ" : "▶")</i><span><b>@(_project.IsActive ? "Pause monitoring" : "Activate monitoring")</b><small>@(_project.IsActive ? "Stop checking branches for commits" : "Resume automatic commit detection")</small></span></button></form>
                </div>
            </details>
        </div>
    </div>

    @if (Created || Queued)
    {
        <div class="detail-alert" data-global-toast><span>✓</span><div><strong>@(Created ? "Project created" : "Deployment queued")</strong><small>@(Created ? "The pipeline is ready. Activate it to begin monitoring." : "The agent will pick up this project on its next cycle.")</small></div></div>
    }
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="detail-alert error" data-global-toast><span>!</span><div><strong>Action unavailable</strong><small>@Error</small></div></div>
    }

    @if (_showPreflight && _preflight is not null)
    {
        <section class="preflight-panel @(_preflight.CanDeploy ? "passed" : "blocked")">
            <header><div><span>@(_preflight.CanDeploy ? "✓" : "!")</span><div><h2>@(_preflight.CanDeploy ? "Ready to deploy" : "Preflight needs attention")</h2><p>Checked @_preflight.CheckedAt.ToLocalTime().ToString("dd MMM, HH:mm") · @_preflight.PassedCount passed · @_preflight.WarningCount warning@(_preflight.WarningCount == 1 ? "" : "s") · @_preflight.FailedCount failed</p></div></div><div class="preflight-tools"><button type="button" @onclick="RunPreflightAsync" disabled="@_preflightRunning">@(_preflightRunning ? "Checking..." : "Run again")</button><button class="preflight-close" type="button" aria-label="Close preflight results" title="Close" @onclick="DismissPreflight">×</button></div></header>
            <div class="preflight-checks">
                @foreach (var check in _preflight.Checks)
                {
                    <div class="preflight-check @check.Status.ToString().ToLowerInvariant()"><i>@CheckIcon(check.Status)</i><div><strong>@check.Name</strong><small>@check.Detail</small></div></div>
                }
            </div>
        </section>
    }

    <div class="project-status-grid">
        <div class="status-card primary"><small>PROJECT STATUS</small><strong class="@ProjectStatusClass"><i></i>@ProjectStatusText</strong><p>@ProjectStatusHelp</p></div>
        <div class="status-card"><small>LAST DEPLOYMENT</small><strong class="@StatusClass(_history.FirstOrDefault()?.Status)">@(_history.FirstOrDefault()?.Status.ToString() ?? "No deployments")</strong><p>@(_history.FirstOrDefault()?.StartedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "Waiting for the first run")</p></div>
        <div class="status-card"><small>SUCCESS RATE</small><strong>@SuccessRate%</strong><p>@_history.Count deployment@(_history.Count == 1 ? "" : "s") recorded</p></div>
        <div class="status-card"><small>LAST COMMIT</small><strong class="sha">@ShortSha(_project.LastSuccessfulCommitSha)</strong><p>@(_project.LastSuccessfulCommitSha is null ? "Nothing deployed yet" : "Successfully deployed")</p></div>
    </div>

    <section class="current-pipeline">
        <header><div><span class="pulse @(_current is null ? (DeployState.AgentOnline ? "idle" : "offline") : "")"></span><div><h2>@PipelineTitle</h2><p>@PipelineSubtitle</p></div></div><span class="environment">@_project.Environment</span></header>
        <div class="pipeline-steps">
            <div class="@StepClass(PipelineStage.Source)"><span>⑂</span><div><small>01 · SOURCE</small><strong>GitHub</strong><p>@_project.GitHub.Branch</p></div></div><i></i>
            <div class="@StepClass(PipelineStage.Build)"><span>⌘</span><div><small>02 · BUILD</small><strong>@(_project.Kind == ProjectKind.BlazorWebApp ? "Blazor Web App" : string.IsNullOrWhiteSpace(_project.Build.ReactProjectPath) ? ".NET" : ".NET + React")</strong><p>@_project.Build.TimeoutMinutes min timeout</p></div></div><i></i>
            <div class="@StepClass(PipelineStage.Deploy)"><span>◈</span><div><small>03 · DEPLOY</small><strong>IIS</strong><p>@_project.IIS.AppPoolName</p></div></div><i></i>
            <div class="@StepClass(PipelineStage.Verify)"><span>✓</span><div><small>04 · VERIFY</small><strong>Health</strong><p>@(string.IsNullOrWhiteSpace(_project.IIS.HealthCheckUrl) ? "App pool" : "HTTP check")</p></div></div>
        </div>
    </section>

    <div class="detail-columns">
        <section class="detail-card live-card">
            <header><div><h2>@(_selectedRunId is null ? "Live output" : "Run output")</h2><p>@(_selectedRunId is null ? "Latest deployment" : $"{_selectedRun?.ShortSha} · {_selectedRun?.StartedAt.ToLocalTime():dd MMM, HH:mm}") · @VisibleLogs.Count() log lines</p></div><div class="log-tools">@if (_selectedRunId is not null){<button type="button" @onclick="BackToLiveAsync">↩ Live</button>}<button type="button" @onclick="ClearOutput" disabled="@(!VisibleLogs.Any())">Clear output</button><span class="@(_selectedRunId is not null ? "archive-badge" : DeployState.AgentOnline ? "" : "offline-badge")">@(_selectedRunId is not null ? "HISTORY" : DeployState.AgentOnline ? "LIVE" : "AGENT OFFLINE")</span></div></header>
            <div class="mini-logs" id="liveProjectLogs">
                @if (!VisibleLogs.Any())
                {
                    <div class="empty-log"><span>›_</span><p>@(_outputCleared ? "Output cleared from view. Saved run logs are still available in history." : "No output for this run yet.")</p></div>
                }
                @foreach (var line in VisibleLogs)
                {
                    <div class="log-line @line.CssClass"><time>@line.TimeDisplay</time><span>@line.Message</span></div>
                }
            </div>
        </section>
        <section class="detail-card history-card">
            <header><div><h2>Recent deployments</h2><p>Project-specific history</p></div><span>@_history.Count</span></header>
            <div class="history-list">
                @if (_history.Count == 0)
                {
                    <div class="empty-history"><span>◷</span><p>No deployments have run for this project.</p></div>
                }
                @foreach (var run in PagedHistory)
                {
                    <div class="history-item @(_selectedRunId == run.Id ? "selected" : "")"><span class="history-status @StatusClass(run.Status)"></span><button class="history-open" type="button" title="View this run's logs" @onclick="() => SelectRunAsync(run)"><strong>@run.CommitMessage</strong><small>@run.CommitAuthor · @run.Branch · @run.StartedAt.ToLocalTime().ToString("dd MMM, HH:mm")</small></button><code>@run.ShortSha</code><b class="@StatusClass(run.Status)">@run.Status</b><div class="history-actions">@if (run.Status is DeployStatus.Failed or DeployStatus.Cancelled){<form method="post" action="/projects/@ProjectId/deploy"><AntiforgeryToken /><input type="hidden" name="branch" value="@run.Branch" /><button class="retry-run" type="submit" disabled="@(_current is not null)">↻ Retry</button></form>}@if (run.Status is not (DeployStatus.Running or DeployStatus.Queued)){<button class="delete-run" type="button" title="Delete this run" aria-label="Delete run @run.ShortSha" @onclick="() => _pendingDeleteRun = run">×</button>}</div></div>
                }
            </div>
            @if (HistoryPageCount > 1)
            {
                <nav class="pager" aria-label="Deployment history pages"><button type="button" @onclick="() => SetHistoryPage(_historyPage - 1)" disabled="@(_historyPage == 1)">‹</button><span>Page @_historyPage of @HistoryPageCount</span><button type="button" @onclick="() => SetHistoryPage(_historyPage + 1)" disabled="@(_historyPage == HistoryPageCount)">›</button></nav>
            }
        </section>
    </div>
    @if (_pendingDeleteRun is not null)
    {
        <div class="delete-overlay" role="presentation" @onclick="() => _pendingDeleteRun = null"><div class="delete-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-run-title" @onclick:stopPropagation="true"><span>⌫</span><h2 id="delete-run-title">Delete this deployment record?</h2><p>The run and its saved logs will be removed from your history. This cannot be undone.</p><div><button type="button" @onclick="() => _pendingDeleteRun = null">Cancel</button><button class="confirm-delete" type="button" @onclick="DeleteSelectedRunAsync">Delete run</button></div></div></div>
    }
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [SupplyParameterFromQuery(Name = "created")] public bool Created { get; set; }
    [SupplyParameterFromQuery(Name = "queued")] public bool Queued { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private ProjectSummary? _project;
    private List<DeployRecord> _history = [];
    private List<LogEntry> _logs = [];
    private DeployRecord? _current;
    private ProjectPreflightReport? _preflight;
    private bool _preflightRunning;
    private bool _showPreflight = true;
    private DeployRecord? _selectedRun;
    private Guid? _selectedRunId;
    private DeployRecord? _pendingDeleteRun;
    private DateTime? _clearAfter;
    private bool _outputCleared;
    private IEnumerable<LogEntry> VisibleLogs => _outputCleared && _selectedRunId is not null
        ? []
        : _logs.Where(x => _clearAfter is null || x.Timestamp > _clearAfter.Value);
    private const int HistoryPageSize = 7;
    private int _historyPage = 1;
    private string? _ownerId;
    private readonly CancellationTokenSource _refreshCancellation = new();
    private int SuccessRate => _history.Count == 0 ? 0 : (int)((double)_history.Count(x => x.Status == DeployStatus.Success) / _history.Count * 100);
    private string ProjectStatusText => !_project!.IsActive ? "Paused" : !DeployState.AgentOnline ? "Agent offline" : _current is null ? "Monitoring" : _current.Stage.ToString();
    private string ProjectStatusClass => !_project!.IsActive ? "muted" : !DeployState.AgentOnline ? "failed" : _current is null ? "green" : "running";
    private string ProjectStatusHelp => !_project!.IsActive
        ? "Commit monitoring is disabled"
        : !DeployState.AgentOnline
            ? "Start or update the LocalGhost Agent service"
            : _current is null
                ? $"Agent connected · checks every {_project.PollIntervalSeconds} seconds"
                : _current.StageMessage;
    private string PipelineTitle => _current is not null
        ? $"{_current.Stage} · {_current.ShortSha}"
        : DeployState.AgentOnline ? "Pipeline ready" : "Waiting for agent";
    private string PipelineSubtitle => _current?.StageMessage
        ?? (DeployState.AgentOnline ? "Watching the configured GitHub branches for commits." : "The dashboard is online, but no compatible agent is connected.");
    private int HistoryPageCount => Math.Max(1, (int)Math.Ceiling(_history.Count / (double)HistoryPageSize));
    private IEnumerable<DeployRecord> PagedHistory => _history.Skip((_historyPage - 1) * HistoryPageSize).Take(HistoryPageSize);
    protected override async Task OnInitializedAsync()
    {
        _ownerId = Users.GetUserId((await AuthenticationState.GetAuthenticationStateAsync()).User);
        if (_ownerId is null) return;
        _project = await ProjectsService.GetProjectAsync(_ownerId, ProjectId);
        if (_project is null) return;
        _history = await ProjectsService.GetHistoryAsync(_ownerId, ProjectId);
        _logs = _history.Count > 0 ? await ProjectsService.GetRunLogsAsync(_ownerId, ProjectId, _history[0].Id) : [];
        _current = DeployState.GetCurrent(ProjectId);
        _preflight = Preflight.GetLatest(_ownerId, ProjectId);
        if (_current is not null) _logs = DeployState.GetCurrentLogs(ProjectId).ToList();
        DeployState.OnChange += Refresh;
        _ = RefreshClockAsync(_refreshCancellation.Token);
    }
    private void Refresh()
    {
        _ = InvokeAsync(RefreshViewAsync);
    }
    private async Task RefreshViewAsync()
    {
        var wasRunning = _current is not null;
        _current = DeployState.GetCurrent(ProjectId);
        if (_selectedRunId is not null)
        {
            // Preserve the chosen historical logs while refreshing the run list after a deployment finishes.
            if (wasRunning && _current is null && _ownerId is not null)
            {
                _history = await ProjectsService.GetHistoryAsync(_ownerId, ProjectId);
                _historyPage = Math.Min(_historyPage, HistoryPageCount);
                _project = await ProjectsService.GetProjectAsync(_ownerId, ProjectId);
            }
        }
        else if (_current is not null)
        {
            _logs = DeployState.GetCurrentLogs(ProjectId).ToList();
        }
        else if (_ownerId is not null)
        {
            _history = await ProjectsService.GetHistoryAsync(_ownerId, ProjectId);
            _historyPage = Math.Min(_historyPage, HistoryPageCount);
            _logs = _history.Count > 0 ? await ProjectsService.GetRunLogsAsync(_ownerId, ProjectId, _history[0].Id) : [];
            _project = await ProjectsService.GetProjectAsync(_ownerId, ProjectId);
        }
        StateHasChanged();
        await Task.Yield();
        try { await JS.InvokeVoidAsync("scrollToBottom", "liveProjectLogs"); } catch { }
    }
    private async Task RefreshClockAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken)) await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }
    public void Dispose()
    {
        DeployState.OnChange -= Refresh;
        _refreshCancellation.Cancel();
        _refreshCancellation.Dispose();
    }
    private static string Initials(string name) => string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private static string ShortSha(string? sha) => string.IsNullOrWhiteSpace(sha) ? "—" : sha[..Math.Min(7, sha.Length)];
    private static string StatusClass(DeployStatus? status) => status switch { DeployStatus.Success => "success", DeployStatus.Failed => "failed", DeployStatus.Running => "running", DeployStatus.Queued => "queued", _ => "muted" };
    private void SetHistoryPage(int page) => _historyPage = Math.Clamp(page, 1, HistoryPageCount);
    private void DismissPreflight()
    {
        _showPreflight = false;
        if (_ownerId is not null) Preflight.Dismiss(_ownerId, ProjectId);
    }
    private async Task SelectRunAsync(DeployRecord run)
    {
        if (_ownerId is null) return;
        _selectedRunId = run.Id;
        _selectedRun = run;
        _logs = await ProjectsService.GetRunLogsAsync(_ownerId, ProjectId, run.Id);
        _clearAfter = null;
        _outputCleared = false;
        try { await JS.InvokeVoidAsync("scrollToBottom", "liveProjectLogs"); } catch { }
    }
    private async Task BackToLiveAsync()
    {
        _selectedRunId = null;
        _selectedRun = null;
        _clearAfter = null;
        _outputCleared = false;
        if (_current is not null) _logs = DeployState.GetCurrentLogs(ProjectId).ToList();
        else if (_ownerId is not null) _logs = _history.Count > 0 ? await ProjectsService.GetRunLogsAsync(_ownerId, ProjectId, _history[0].Id) : [];
    }
    private void ClearOutput()
    {
        _outputCleared = true;
        _clearAfter = DateTime.UtcNow;
    }
    private async Task DeleteSelectedRunAsync()
    {
        if (_ownerId is null || _pendingDeleteRun is null) return;
        var runId = _pendingDeleteRun.Id;
        _pendingDeleteRun = null;
        if (!await ProjectsService.DeleteRunAsync(_ownerId, ProjectId, runId)) return;
        _history = await ProjectsService.GetHistoryAsync(_ownerId, ProjectId);
        _historyPage = Math.Min(_historyPage, HistoryPageCount);
        _project = await ProjectsService.GetProjectAsync(_ownerId, ProjectId);
        if (_selectedRunId == runId || _selectedRunId is null) await BackToLiveAsync();
    }
    private async Task RunPreflightAsync()
    {
        if (_ownerId is null || _preflightRunning) return;
        _preflightRunning = true;
        try { _preflight = await Preflight.RunAsync(_ownerId, ProjectId, _refreshCancellation.Token); _showPreflight = true; }
        finally { _preflightRunning = false; }
    }
    private static string CheckIcon(PreflightCheckStatus status) => status switch
    {
        PreflightCheckStatus.Passed => "✓",
        PreflightCheckStatus.Warning => "!",
        _ => "×"
    };
    private string StepClass(PipelineStage step)
    {
        if (_current is null) return DeployState.AgentOnline ? "ready" : string.Empty;
        if (_current.Stage == PipelineStage.Completed || (int)_current.Stage > (int)step) return "complete";
        return _current.Stage == step ? "running" : string.Empty;
    }
}

