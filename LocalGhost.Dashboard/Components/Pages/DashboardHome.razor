n:none}.dashboard-project-list>a:hover{background:#1a1e2d}.mini-mark{width:34px;height:34px;display:grid;place-items:center;border:1px solid #413665;border-radius:9px;background:#25203d;color:#b9a7f4;font-size:10px;font-weight:800}.dashboard-project-list strong,.dashboard-project-list small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.dashboard-project-list strong{margin-bottom:3px;color:#bfc8d6;font-size:9px}.dashboard-project-list small{color:#4f5a6c;font-size:7px}.dashboard-project-list b{display:flex;align-items:center;gap:5px;font-size:7px}.dashboard-project-list b i{width:5px;height:5px;border-radius:50%;background:currentColor}.success{color:#34d399}.failed{color:#f87171}.running{color:#60a5fa}.muted{color:#778295}.dashboard-project-list code{color:#7e8a9e;font-size:8px;text-align:right}.activity-list>a{display:grid;grid-template-columns:7px minmax(0,1fr) 48px 68px;align-items:center;gap:9px;padding:12px 16px;border-bottom:1px solid #22273a;color:inherit;text-decoration:none}.activity-list>a:hover{background:#1a1e2d}.activity-dot{width:7px;height:7px;border-radius:50%;background:#657084}.activity-dot.success{background:#34d399}.activity-dot.failed{background:#f87171}.activity-dot.running{background:#60a5fa}.activity-list strong,.activity-list small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.activity-list strong{margin-bottom:3px;color:#bfc8d6;font-size:9px}.activity-list small{color:#4f5a6c;font-size:7px}.activity-list code,.activity-list time{color:#657185;font-size:7px}.no-activity,.dashboard-empty{display:grid;place-content:center;text-align:center}.no-activity{min-height:260px;color:#526074}.no-activity span{font-size:24px}.no-activity p{font-size:9px}.dashboard-empty{min-height:560px;border:1px solid #292743;border-radius:16px;background:radial-gradient(circle at 50% 10%,#292049,#171927 45%)}.dashboard-empty>span{color:#a78bfa;font-size:28px}.dashboard-empty h1{margin:13px 0 8px;color:#f8fafc;font-size:25px}.dashboard-empty p{max-width:440px;margin:0 auto 20px;color:#718096;font-size:10px;line-height:1.6}.dashboard-empty a{color:#b9a7f4;text-decoration:none;font-size:10px;font-weight:700}@@media(max-width:950px){.dashboard-stats{grid-template-columns:1fr 1fr}.dashboard-grid{grid-template-columns:1fr}}@@media(max-width:560px){.dashboard-stats{grid-template-columns:1fr}}
</style>
