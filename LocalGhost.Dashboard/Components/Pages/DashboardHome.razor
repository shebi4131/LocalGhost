@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationState
@inject UserManager<IdentityUser> Users
@inject ProjectService ProjectsService

<PageTitle>Dashboard · LocalGhost</PageTitle>

<div class="dashboard-head"><div><div class="page-title">Deployment overview</div><div class="page-sub">A live summary of every project in your workspace.</div></div><a href="/projects/new">＋ Add project</a></div>

@if (_projects.Count == 0)
{
    <section class="dashboard-empty"><span>◆</span><h1>Your workspace is ready.</h1><p>Create a project to connect GitHub, build your application, and deploy it to IIS.</p><a href="/projects/new">Create first project →</a></section>
}
else
{
    <div class="dashboard-stats">
        <div><span class="stat-icon violet">◆</span><div><small>TOTAL PROJECTS</small><strong>@_projects.Select(x => x.ProjectGroupId).Distinct().Count()</strong><p>@_projects.Count environments · @_projects.Count(x => x.IsActive) monitored</p></div></div>
        <div><span class="stat-icon blue">▶</span><div><small>DEPLOYMENTS</small><strong>@_projects.Sum(x => x.DeploymentCount)</strong><p>Across all projects</p></div></div>
        <div><span class="stat-icon green">✓</span><div><small>SUCCESS RATE</small><strong>@OverallSuccessRate%</strong><p>All completed runs</p></div></div>
        <div><span class="stat-icon rose">!</span><div><small>NEED ATTENTION</small><strong>@_projects.Count(x => x.LastDeploymentStatus == DeployStatus.Failed)</strong><p>Environments with a failed latest run</p></div></div>
    </div>

    <div class="dashboard-grid">
        <section class="dashboard-card projects-panel"><header><div><h2>Projects by environment</h2><p>Deployment health for each target</p></div><a href="/projects">View all →</a></header>
            <div class="dashboard-project-list">
                @foreach (var project in _projects.Take(6))
                {
                    <a href="/projects/@project.Id"><span class="mini-mark">@Initial(project.Name)</span><div><strong>@project.Name <em class="dashboard-env">@project.Environment</em></strong><small>@project.GitHub.RepoOwner/@project.GitHub.RepoName · @project.GitHub.Branch</small></div><b class="@StatusClass(project)"><i></i>@StatusText(project)</b><code>@ShortSha(project.LastSuccessfulCommitSha)</code></a>
                }
            </div>
        </section>
        <section class="dashboard-card activity-panel"><header><div><h2>Recent activity</h2><p>Latest runs across your workspace</p></div><span>LIVE</span></header>
            <div class="activity-list">
                @if (_recent.Count == 0)
                {
                    <div class="no-activity"><span>◷</span><p>No deployments yet.</p></div>
                }
                @foreach (var run in PagedActivity)
                {
                    <a href="/projects/@run.ProjectId"><span class="activity-dot @StatusClass(run.Status)"></span><div><strong>@run.ProjectName <em class="dashboard-env">@EnvironmentFor(run.ProjectId)</em></strong><small>@run.CommitMessage</small></div><code>@run.ShortSha</code><time>@run.StartedAt.ToLocalTime().ToString("dd MMM, HH:mm")</time></a>
                }
            </div>
            @if (ActivityPageCount > 1)
            {
                <nav class="activity-pager" aria-label="Recent activity pages"><button type="button" disabled="@(_activityPage == 1)" @onclick="() => SetActivityPage(_activityPage - 1)">← Previous</button><span>Page @_activityPage of @ActivityPageCount</span><button type="button" disabled="@(_activityPage == ActivityPageCount)" @onclick="() => SetActivityPage(_activityPage + 1)">Next →</button></nav>
            }
        </section>
    </div>
}

@code {
    private List<ProjectSummary> _projects = [];
    private List<DeployRecord> _recent = [];
    private const int ActivityPageSize = 7;
    private int _activityPage = 1;
    private int ActivityPageCount => Math.Max(1, (int)Math.Ceiling(_recent.Count / (double)ActivityPageSize));
    private IEnumerable<DeployRecord> PagedActivity => _recent.Skip((_activityPage - 1) * ActivityPageSize).Take(ActivityPageSize);
    private int OverallSuccessRate => _recent.Count == 0 ? 0 : (int)((double)_recent.Count(x => x.Status == DeployStatus.Success) / _recent.Count * 100);
    protected override async Task OnInitializedAsync()
    {
        var ownerId = Users.GetUserId((await AuthenticationState.GetAuthenticationStateAsync()).User);
        if (ownerId is null) return;
        _projects = await ProjectsService.GetProjectsAsync(ownerId);
        _recent = await ProjectsService.GetRecentHistoryAsync(ownerId, 100);
    }
    private void SetActivityPage(int page) => _activityPage = Math.Clamp(page, 1, ActivityPageCount);
    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "P" : name[..1].ToUpperInvariant();
    private string EnvironmentFor(Guid projectId) => _projects.FirstOrDefault(x => x.Id == projectId)?.Environment ?? "Removed environment";
    private static string ShortSha(string? sha) => string.IsNullOrWhiteSpace(sha) ? "—" : sha[..Math.Min(7, sha.Length)];
    private static string StatusText(ProjectSummary p) => !p.IsActive ? "Paused" : p.LastDeploymentStatus?.ToString() ?? "Ready";
    private static string StatusClass(ProjectSummary p) => !p.IsActive ? "muted" : StatusClass(p.LastDeploymentStatus);
    private static string StatusClass(DeployStatus? status) => status switch { DeployStatus.Success => "success", DeployStatus.Failed => "failed", DeployStatus.Running => "running", _ => "muted" };
}

