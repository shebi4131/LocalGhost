@page "/projects/{ProjectId:guid}/workspace"
@attribute [Authorize]
@rendermode InteractiveServer
@using LocalGhost.Dashboard.Data
@inject AuthenticationStateProvider AuthenticationState
@inject UserManager<IdentityUser> Users
@inject ProjectWorkspaceService Workspaces
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Environments &amp; team · LocalGhost</PageTitle>

@if (_environments.Count == 0)
{
    <div class="workspace-empty">Project not found or access denied. <a href="/projects">Back to projects</a></div>
}
else
{
    <div class="workspace-head"><div><a href="/projects/@ProjectId">← Project pipeline</a><h1>@_environments[0].Name</h1><p>Environments, access, and release responsibility in one place.</p></div><span>@_environments.Count environment@(_environments.Count == 1 ? "" : "s")</span></div>
    @if (!string.IsNullOrWhiteSpace(Error)) { <div class="workspace-alert">@Error</div> }
    @if (MemberAdded || MemberRemoved) { <div class="workspace-alert success">Team membership updated.</div> }
    @if (EnvironmentRemoved || EnvironmentRestored) { <div class="workspace-alert success">Environment @(EnvironmentRemoved ? "removed from active projects" : "restored in paused mode").</div> }
    @if (!string.IsNullOrWhiteSpace(Invite)) { <div class="workspace-invite"><strong>Invitation ready — share this private link</strong><div class="invite-copy-row"><input readonly value="@InvitationUrl" onclick="this.select()" /><button type="button" title="Copy invitation link" aria-label="Copy invitation link" @onclick="CopyInviteAsync"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg><span>@(_inviteCopied ? "Copied" : "Copy link")</span></button></div><small>One use · expires in seven days. Anyone with this link can accept it after signing in.</small></div> }

    <section class="workspace-section" id="environments"><header><div><small>DEPLOYMENT TARGETS</small><h2>Environments</h2><p>Each target has its own branch rules, build paths, IIS settings, and deployment history.</p></div></header>
        <div class="workspace-grid">
            @foreach (var environment in _environments)
            {
                <article class="environment-card"><div><span class="env-icon">◈</span><span class="env-status @(environment.IsActive ? "active" : "paused")">@(environment.IsActive ? "Monitoring" : "Paused")</span></div><h3>@environment.Environment</h3><p>@environment.RepoOwner/@environment.RepoName · @environment.Branch</p><small>@(environment.RequiresApproval ? "Approval required before deploy" : "Automatic deployment allowed")</small><div class="environment-actions"><a href="/projects/@environment.Id">Open pipeline →</a>@if (_isOwner && _environments.Count > 1){<button type="button" disabled="@(environment.IsActive || environment.IsDeploymentInProgress)" title="@(environment.IsActive ? "Pause this environment before removing it" : "Remove environment")" @onclick="() => _pendingRemove = environment">Remove</button>}</div></article>
            }
        </div>
        @if (_isOwner)
        {
            <form class="workspace-form" method="post" action="/projects/@ProjectId/environments"><AntiforgeryToken /><div><strong>Add an environment</strong><small>Creates a paused pipeline. Configure a distinct IIS destination before activation.</small></div><input name="environment" maxlength="50" placeholder="e.g. Staging" required /><button type="submit">＋ Add environment</button></form>
            @if (_archived.Count > 0) { <details class="removed-environments"><summary>Removed environments (@_archived.Count)</summary>@foreach (var removed in _archived){<div><span>@removed.Environment <small>Deployment history and settings preserved</small></span><form method="post" action="/projects/@ProjectId/environments/@removed.Id/restore"><AntiforgeryToken /><button type="submit">Restore paused</button></form></div>}</details> }
        }
    </section>

    <section class="workspace-section" id="team"><header><div><small>COLLABORATION</small><h2>Project team</h2><p>The owner has full access. Members receive a role across all environments in this project.</p></div></header>
        <div class="members"><div><span class="member-avatar">@Initial(_ownerEmail)</span><span><strong>@_ownerEmail</strong><small>Project owner · full access</small></span></div>
            @foreach (var member in _members)
            {
                <div><span class="member-avatar">@Initial(member.Email)</span><span><strong>@member.Email</strong><small>@member.Role · @member.Scope · added @member.AddedAt.ToLocalTime().ToString("dd MMM yyyy")</small></span>@if (_isOwner){<form method="post" action="/projects/@ProjectId/members/remove"><AntiforgeryToken /><input type="hidden" name="userId" value="@member.UserId" /><button type="submit" aria-label="Remove @member.Email">Remove</button></form>}</div>
            }
        </div>
        @if (_isOwner)
        {
            <form class="workspace-form" method="post" action="/projects/@ProjectId/invites"><AntiforgeryToken /><div><strong>Invite a teammate</strong><small>Create a one-use link and share it privately. Viewer can inspect; Deployer can run; Manager can configure and approve. Environment-specific access appears after its first successful deployment.</small></div><select name="role"><option>Viewer</option><option>Deployer</option><option>Manager</option></select><select name="environmentId"><option value="">Project-wide access</option>@foreach (var environment in _environments.Where(x => x.IsActive && !string.IsNullOrWhiteSpace(x.LastSuccessfulCommitSha) && !string.IsNullOrWhiteSpace(x.SitePath) && !string.IsNullOrWhiteSpace(x.AppPoolName) && !string.IsNullOrWhiteSpace(x.BackupPath))){<option value="@environment.Id">@environment.Environment only</option>}</select><button type="submit">Create invite</button></form>
        }
    </section>
    @if (_pendingRemove is not null)
    {
        <div class="environment-confirm-backdrop" role="presentation" @onclick="() => _pendingRemove = null"><div class="environment-confirm" role="dialog" aria-modal="true" aria-labelledby="remove-environment-title" @onclick:stopPropagation="true"><h2 id="remove-environment-title">Remove @_pendingRemove.Environment?</h2><p>This pauses and hides the environment. Its settings and deployment history are kept, and you can restore it later. No IIS files or SQL data are deleted.</p><div><button type="button" @onclick="() => _pendingRemove = null">Cancel</button><form method="post" action="/projects/@ProjectId/environments/@_pendingRemove.Id/remove"><AntiforgeryToken /><button class="confirm-remove" type="submit">Remove environment</button></form></div></div></div>
    }
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "invite")] public string? Invite { get; set; }
    [SupplyParameterFromQuery(Name = "memberAdded")] public bool MemberAdded { get; set; }
    [SupplyParameterFromQuery(Name = "memberRemoved")] public bool MemberRemoved { get; set; }
    [SupplyParameterFromQuery(Name = "environmentRemoved")] public bool EnvironmentRemoved { get; set; }
    [SupplyParameterFromQuery(Name = "environmentRestored")] public bool EnvironmentRestored { get; set; }
    private List<ProjectEntity> _environments = [];
    private List<ProjectEntity> _archived = [];
    private ProjectEntity? _pendingRemove;
    private List<MemberView> _members = [];
    private List<ProjectEnvironmentGrantEntity> _grants = [];
    private string _ownerEmail = "Owner";
    private bool _isOwner;
    private bool _inviteCopied;
    private string InvitationUrl => Navigation.BaseUri.TrimEnd('/') + "/invites/" + Invite;
    private async Task CopyInviteAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", InvitationUrl);
            _inviteCopied = true;
        }
        catch (JSException) { _inviteCopied = false; }
    }
    protected override async Task OnParametersSetAsync()
    {
        var userId = Users.GetUserId((await AuthenticationState.GetAuthenticationStateAsync()).User);
        if (userId is null) return;
        _environments = await Workspaces.GetEnvironmentsAsync(userId, ProjectId);
        if (_environments.Count == 0) return;
        _isOwner = _environments[0].OwnerUserId == userId;
        _archived = _isOwner ? await Workspaces.GetArchivedEnvironmentsAsync(userId, ProjectId) : [];
        _ownerEmail = (await Users.FindByIdAsync(_environments[0].OwnerUserId))?.Email ?? "Owner";
        var members = await Workspaces.GetMembersAsync(userId, ProjectId);
        _grants = await Workspaces.GetGrantsAsync(userId, ProjectId);
        _members = [];
        foreach (var member in members)
        {
            var grant = _grants.FirstOrDefault(x => x.UserId == member.UserId);
            var scope = grant is null ? "all environments" : _environments.FirstOrDefault(x => x.Id == grant.ProjectId)?.Environment ?? "selected environment";
            _members.Add(new MemberView(member.UserId, (await Users.FindByIdAsync(member.UserId))?.Email ?? "Unknown user",
                grant?.Role ?? member.Role, member.AddedAt, scope));
        }
    }
    private static string Initial(string value) => string.IsNullOrWhiteSpace(value) ? "?" : value[..1].ToUpperInvariant();
    private sealed record MemberView(string UserId, string Email, ProjectMemberRole Role, DateTime AddedAt, string Scope);
}

