    .workspace-invite{display:grid;gap:7px;margin-bottom:17px;padding:15px;border:1px solid #5b4b86;border-radius:11px;background:#242038}.workspace-invite strong{color:#ded3ff;font-size:11px}.invite-copy-row{display:flex;gap:8px}.workspace-invite input{flex:1;min-width:0;padding:9px;border:1px solid #65568a;border-radius:7px;background:#10131d;color:#f0edff;font:10px 'Courier New',monospace}.invite-copy-row button{display:inline-flex;align-items:center;gap:6px;padding:8px 12px;border:1px solid #8662df;border-radius:8px;background:#493181;color:#fff;cursor:pointer;white-space:nowrap;font-size:11px;font-weight:700}.invite-copy-row button:hover{background:#6545b1}.workspace-invite small{color:#b9abd4;font-size:9px}
    .workspace-empty,.workspace-alert{padding:18px;border:1px solid #613d50;border-radius:11px;background:#241a27;color:#fda4af}.workspace-alert{margin:17px 0}.workspace-alert.success{border-color:#28604f;background:#142c27;color:#6ee7b7}.workspace-empty a{color:#c4b5fd}.workspace-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:25px}.workspace-head a{color:#b5a2ec;text-decoration:none;font-size:11px}.workspace-head h1{margin:9px 0 5px;color:#f1f5f9;font-size:28px}.workspace-head p,.workspace-section header p{margin:0;color:#9aa8bd;font-size:12px}.workspace-head>span{padding:7px 10px;border:1px solid #52446f;border-radius:20px;color:#d1c1f7;font-size:11px}.workspace-section{margin-bottom:25px;padding:22px;border:1px solid #2c3247;border-radius:16px;background:#171b29}.workspace-section header small{color:#b79df7;font-size:9px;font-weight:800;letter-spacing:1.3px}.workspace-section header h2{margin:6px 0;color:#eef2f8;font-size:19px}.workspace-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-top:22px}.environment-card{padding:17px;border:1px solid #343a53;border-radius:12px;background:#111622}.environment-card>div{display:flex;justify-content:space-between;align-items:center}.env-icon{display:grid;place-items:center;width:31px;height:31px;border:1px solid #54457b;border-radius:8px;background:#2d2446;color:#c5adff}.env-status{color:#9ba7b8;font-size:10px}.env-status.active{color:#6ee7b7}.environment-card h3{margin:17px 0 5px;color:#f2f4fa;font-size:16px}.environment-card p,.environment-card small{display:block;margin:0 0 7px;color:#a2afc2;font-size:11px;overflow-wrap:anywhere}.environment-card small{color:#b5a2dc}.environment-card a{display:inline-block;margin-top:12px;color:#c4b5fd;text-decoration:none;font-size:11px;font-weight:700}.workspace-form{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin-top:18px;padding:15px;border:1px solid #353b53;border-radius:11px;background:#111622}.workspace-form>div{flex:1 1 260px}.workspace-form strong,.workspace-form small{display:block}.workspace-form strong{color:#e8edf5;font-size:12px}.workspace-form small{margin-top:4px;color:#9aa8bd;font-size:10px;line-height:1.5}.workspace-form input,.workspace-form select{min-height:37px;padding:8px 10px;border:1px solid #414961;border-radius:8px;background:#0d121d;color:#e4e9f1;font-size:11px}.workspace-form button{min-height:37px;padding:8px 13px;border:0;border-radius:8px;background:#7048d1;color:white;cursor:pointer;font-size:11px;font-weight:700}.members{margin-top:20px;border:1px solid #30374d;border-radius:11px;overflow:hidden}.members>div{display:flex;align-items:center;gap:10px;padding:12px 14px;background:#111622}.members>div+div{border-top:1px solid #30374d}.member-avatar{display:grid;place-items:center;width:31px;height:31px;border-radius:9px;background:#302650;color:#c4b5fd;font-size:12px;font-weight:800}.members>div>span:nth-child(2){flex:1;min-width:0}.members strong,.members small{display:block}.members strong{color:#e8edf5;font-size:11px}.members small{margin-top:3px;color:#96a2b5;font-size:10px}.members button{border:1px solid #5b3a49;border-radius:7px;background:#2d1e27;color:#f3a9b9;padding:7px 10px;cursor:pointer;font-size:10px}@@media(max-width:650px){.workspace-head{align-items:flex-start;flex-direction:column}.workspace-form input,.workspace-form select,.workspace-form button{width:100%}}
</style>
