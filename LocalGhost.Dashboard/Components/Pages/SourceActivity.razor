or:#edf2f9;text-decoration:none;font-size:12px;font-weight:650;overflow-wrap:anywhere}.source-list a:hover{color:#c7b7ff}.source-list p{margin:5px 0 0;color:#9dabc0;font-size:10px;overflow-wrap:anywhere}.source-list code{color:#bdadf0;font-size:10px}.source-pr-state{padding:5px 8px;border-radius:20px;background:#213e35;color:#65e7b3;font-size:9px}.source-pr-state.closed{background:#422b33;color:#f4a8b6}.source-pr-state.merged{background:#3b2d58;color:#cab0ff}.source-empty,.source-error{padding:22px;color:#aab7c9;font-size:12px}.source-error{color:#f8a9b5}@@media(max-width:900px){.source-panels{grid-template-columns:1fr}}
