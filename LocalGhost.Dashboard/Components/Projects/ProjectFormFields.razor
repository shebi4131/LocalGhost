@using LocalGhost.Shared.Models

<div class="project-form-shell @(Model?.Kind == ProjectKind.BlazorWebApp ? "is-blazor" : "")">
    <aside class="form-steps">
        <div class="steps-title">PROJECT SETUP</div>
        <a href="#general"><b>01</b><span>Project details<small>Name and environment</small></span></a>
        <a href="#source"><b>02</b><span>Source control<small>GitHub repository</small></span></a>
        <a href="#build"><b>03</b><span>Build pipeline<small>.NET, optional React</small></span></a>
        <a href="#deploy"><b>04</b><span>IIS deployment<small>Targets and rollback</small></span></a>
        <a href="#notify"><b>05</b><span>Notifications<small>Email delivery</small></span></a>
        <div class="steps-hint"><span>◆</span><p>Secrets are encrypted before they are stored and are never shown again.</p></div>
    </aside>

    <div class="form-sections">
        <section id="general" class="form-section">
            <header><span class="section-icon violet">✦</span><div><h2>Project details</h2><p>Give this deployment pipeline a clear identity.</p></div><b>01</b></header>
            <div class="input-grid">
                <div class="form-field full"><label>Project name <em>Required</em></label><input name="name" value="@(Model?.Name ?? SelectedRepository?.Name)" placeholder="Customer Portal" maxlength="100" required /><small>Displayed across dashboards, history, and notifications.</small></div>
                <div class="form-field"><label>Application type <em>Required</em></label><select name="projectKind" onchange="this.closest('.project-form-shell').classList.toggle('is-blazor', this.value === 'BlazorWebApp')"><option value="AspNet" selected="@(Model?.Kind != ProjectKind.BlazorWebApp)">ASP.NET Core API + optional React</option><option value="BlazorWebApp" selected="@(Model?.Kind == ProjectKind.BlazorWebApp)">ASP.NET Core Blazor Web App</option></select><small>Blazor Web App publishes as one IIS site; no separate React build is needed.</small></div>
                <div class="form-field"><label>Environment</label><select name="environment"><option selected="@(Model?.Environment is null or "Production")">Production</option><option selected="@(Model?.Environment == "Staging")">Staging</option><option selected="@(Model?.Environment == "Development")">Development</option></select><small>Helps distinguish production and non-production targets.</small></div>
                <div class="form-field toggle-field"><label class="switch-row"><span><strong>Activate monitoring</strong><small>Start checking GitHub after this project is saved.</small></span><input name="isActive" type="checkbox" checked="@(Model?.IsActive ?? false)" /><i></i></label></div>
                <div class="form-field full"><label>Description</label><textarea name="description" rows="3" placeholder="What does this project deploy?">@Model?.Description</textarea></div>
            </div>
        </section>

        <section id="source" class="form-section">
            <header><span class="section-icon cyan">⑂</span><div><h2>GitHub source</h2><p>The repository and branch LocalGhost will monitor.</p></div><b>02</b></header>
            <div class="source-auth-choice">
                <label><input type="radio" name="githubAuthMode" value="Local" checked="@UseLocal" /><span><strong>Use GitHub connection</strong><small>Sign in once and choose a repository</small></span></label>
                <label><input type="radio" name="githubAuthMode" value="Pat" checked="@(!UseLocal)" /><span><strong>PAT fallback</strong><small>Keep using a repository read token</small></span></label>
            </div>
            <div class="source-app-card">
                <span class="source-app-mark">⑂</span><div><strong>@(UseLocal && RepositoryId is not null ? $"{RepoOwner}/{RepoName}" : "Choose a GitHub repository")</strong><small>Uses Git Credential Manager for this Windows account.</small></div>
                <a href="@($"/github/repositories?returnTo={Uri.EscapeDataString(ReturnPath)}")">@(RepositoryId is not null ? "Change" : "Browse") →</a>
            </div>
            <input type="hidden" name="githubRepositoryId" value="@RepositoryId" />
            <div class="input-grid three">
                <div class="form-field"><label>Repository owner <em>Required</em></label><input name="repoOwner" value="@RepoOwner" placeholder="organization-or-user" required /><small>GitHub user or organization. Connected selections are verified on save.</small></div>
                <div class="form-field"><label>Repository name <em>Required</em></label><input name="repoName" value="@RepoName" placeholder="my-application" required /><small>Name without the GitHub URL.</small></div>
                <div class="form-field full"><label>Deployment branches <em>At least one</em></label><div class="branch-editor"><div class="branch-chips">@foreach (var branch in ProjectSourceService.ParseBranches(SelectedRepository?.DefaultBranch ?? Model?.GitHub.Branch ?? "main")){<span>@branch</span>}</div><div class="branch-entry-row"><input class="branch-entry" name="newBranch" placeholder="Add branch, e.g. develop" /><button class="branch-add" type="button">＋ Add</button></div><input type="hidden" name="branch" value="@(SelectedRepository?.DefaultBranch ?? Model?.GitHub.Branch ?? "main")" /></div><small>New branches start monitoring at their current commit; old commits will not auto-deploy. Use Deploy now to run one immediately. Press Enter or comma to add.</small></div>
                <div class="form-field full"><label>Backup personal access token <em>@(Model?.HasGitHubToken == true ? "Stored — leave blank to keep" : "Needed only for PAT mode")</em></label><input name="githubToken" type="password" autocomplete="new-password" placeholder="@(Model?.HasGitHubToken == true ? "••••••••••••••••  (unchanged)" : "github_pat_...")" /><small>Stored encrypted; select PAT fallback above to use it for source access.</small></div>
                <div class="form-field"><label>Polling interval</label><div class="input-suffix"><input name="pollIntervalSeconds" type="number" min="10" max="3600" value="@(Model?.PollIntervalSeconds ?? 30)" /><span>seconds</span></div><small>Minimum 10 seconds.</small></div>
            </div>
        </section>

        <section id="build" class="form-section">
            <header><span class="section-icon amber">⌘</span><div><h2>Build pipeline</h2><p>Paths used to restore, compile, and stage output.</p></div><b>03</b></header>
            <div class="input-grid">
                <div class="form-field full"><label>Source checkout directory <em>Required</em></label><div class="path-input-row"><input class="mono" name="sourceCodePath" value="@Model?.Build.SourceCodePath" placeholder="C:\LocalGhost\Source\customer-portal" required /><button type="button" class="path-pick" data-target="sourceCodePath" data-mode="folder" data-title="Select source checkout directory" onclick="chooseLocalPath(this)"><b>▰</b><span>Browse</span></button></div><small>The dashboard clones or pulls the repository here before the worker starts.</small></div>
                <div class="form-field full"><label>.NET project <em>Required</em></label><div class="path-input-row"><input class="mono" name="apiProjectPath" value="@Model?.Build.ApiProjectPath" placeholder="C:\LocalGhost\Source\my-app\MyApp.csproj" required /><button type="button" class="path-pick" data-target="apiProjectPath" data-mode="csproj" data-title="Select .NET project" onclick="chooseLocalPath(this)"><b>◇</b><span>Browse</span></button></div><small>For Blazor, select the server Web App <code>.csproj</code>. This project is published with <code>dotnet publish</code>.</small></div>
                <div class="form-field full"><label>.NET publish output <em>Required</em></label><div class="path-input-row"><input class="mono" name="apiOutputPath" value="@Model?.Build.ApiOutputPath" placeholder="C:\LocalGhost\Builds\my-app\publish" required /><button type="button" class="path-pick" data-target="apiOutputPath" data-mode="folder" data-title="Select .NET publish output directory" onclick="chooseLocalPath(this)"><b>▰</b><span>Browse</span></button></div><small>Staging folder for published files before they are copied into IIS.</small></div>
                <div class="form-field full react-only"><label>React project directory <em>Optional</em></label><div class="path-input-row"><input class="mono" name="reactProjectPath" value="@Model?.Build.ReactProjectPath" placeholder="C:\LocalGhost\Source\customer-portal\client" /><button type="button" class="path-pick" data-target="reactProjectPath" data-mode="folder" data-title="Select React project directory" onclick="chooseLocalPath(this)"><b>▰</b><span>Browse</span></button></div><small>Choose the folder containing <code>package.json</code>. LocalGhost runs <code>npm install</code> and <code>npm run build</code> here.</small></div>
                <div class="form-field full react-only"><label>React build output <em>Required with React</em></label><div class="path-input-row"><input class="mono" name="reactOutputPath" value="@Model?.Build.ReactOutputPath" placeholder="C:\LocalGhost\Source\customer-portal\client\dist" /><button type="button" class="path-pick" data-target="reactOutputPath" data-mode="folder" data-title="Select React build output directory" onclick="chooseLocalPath(this)"><b>▰</b><span>Browse</span></button></div><small>Select the Vite <code>dist</code> or CRA <code>build</code> output directory.</small></div>
                <div class="form-field"><label>Build timeout</label><div class="input-suffix"><input name="buildTimeoutMinutes" type="number" min="1" max="120" value="@(Model?.Build.TimeoutMinutes ?? 10)" /><span>minutes</span></div><small>Applied to each build command.</small></div>
            </div>
        </section>

        <section id="deploy" class="form-section">
            <header><span class="section-icon green">◈</span><div><h2>IIS deployment</h2><p>Live destinations, application pool, and rollback storage.</p></div><b>04</b></header>
            <div class="input-grid">
                <div class="form-field full"><label>.NET IIS site directory <em>Required</em></label><div class="path-input-row"><input class="mono" name="sitePath" value="@Model?.IIS.SitePath" placeholder="C:\inetpub\wwwroot\my-app" required /><button type="button" class="path-pick" data-target="sitePath" data-mode="folder" data-title="Select .NET IIS site directory" onclick="chooseLocalPath(this)"><b>▰</b><span>Browse</span></button></div><small>Published .NET files are copied here while the application pool is stopped. For Blazor, use the server app's IIS site.</small></div>
                <div class="form-field full react-only"><label>Frontend IIS site directory <em>Required with React</em></label><div class="path-input-row"><input class="mono" name="reactSitePath" value="@Model?.IIS.ReactSitePath" placeholder="C:\inetpub\wwwroot\customer-web" /><button type="button" class="path-pick" data-target="reactSitePath" data-mode="folder" data-title="Select IIS frontend site directory" onclick="chooseLocalPath(this)"><b>▰</b><span>Browse</span></button></div><small>Compiled frontend assets are copied here.</small></div>
                <div class="form-field"><label>Application pool <em>Required</em></label><input name="appPoolName" value="@Model?.IIS.AppPoolName" placeholder="customer-api-pool" required /><small>Stopped before copy and restarted afterward.</small></div>
                <div class="form-field"><label>Health-check URL <em>Optional</em></label><input name="healthCheckUrl" type="url" value="@Model?.IIS.HealthCheckUrl" placeholder="https://localhost/health" /><small>Requested after IIS restarts.</small></div>
                <div class="form-field full"><label>Backup directory <em>Required</em></label><div class="path-input-row"><input class="mono" name="backupPath" value="@Model?.IIS.BackupPath" placeholder="C:\LocalGhost\Backups\customer-portal" required /><button type="button" class="path-pick" data-target="backupPath" data-mode="folder" data-title="Select deployment backup directory" onclick="chooseLocalPath(this)"><b>▰</b><span>Browse</span></button></div><small>A timestamped API and frontend backup is created here before every deployment.</small></div>
            </div>
        </section>

        <section id="notify" class="form-section">
            <header><span class="section-icon rose">✉</span><div><h2>Email notifications</h2><p>Optional project-specific deployment alerts.</p></div><b>05</b></header>
            <label class="enable-card"><span class="section-icon rose">✉</span><span><strong>Enable email notifications</strong><small>Send project deployment results through SMTP.</small></span><input name="emailEnabled" type="checkbox" checked="@(Model?.Smtp.Enabled ?? false)" /></label>
            <div class="input-grid three notify-grid">
                <div class="form-field"><label>SMTP host</label><input name="smtpHost" value="@Model?.Smtp.Host" placeholder="smtp.gmail.com" /></div>
                <div class="form-field"><label>Port</label><input name="smtpPort" type="number" min="1" max="65535" value="@(Model?.Smtp.Port ?? 587)" /></div>
                <div class="form-field toggle-field"><label class="switch-row compact"><span><strong>Use TLS</strong><small>Recommended</small></span><input name="smtpEnableSsl" type="checkbox" checked="@(Model?.Smtp.EnableSsl ?? true)" /><i></i></label></div>
                <div class="form-field"><label>Username</label><input name="smtpUsername" value="@Model?.Smtp.Username" autocomplete="username" placeholder="deployments@example.com" /></div>
                <div class="form-field"><label>App password <em>@(Model?.HasSmtpPassword == true ? "Stored" : "")</em></label><input name="smtpPassword" type="password" autocomplete="new-password" placeholder="@(Model?.HasSmtpPassword == true ? "••••••••  (unchanged)" : "SMTP app password")" /></div>
                <div></div>
                <div class="form-field"><label>From address</label><input name="smtpFromAddress" type="email" value="@Model?.Smtp.FromAddress" placeholder="deployments@example.com" /></div>
                <div class="form-field"><label>Recipient</label><input name="smtpToAddress" type="email" value="@Model?.Smtp.ToAddress" placeholder="team@example.com" /></div>
                <div class="notify-checks"><label><input name="notifyOnSuccess" type="checkbox" checked="@(Model?.Smtp.NotifyOnSuccess ?? true)" /> Success</label><label><input name="notifyOnFailure" type="checkbox" checked="@(Model?.Smtp.NotifyOnFailure ?? true)" /> Failure</label></div>
            </div>
        </section>
    </div>
</div>


@code {
    [Parameter] public ProjectSummary? Model { get; set; }
    [Parameter] public GitHubRepositoryOption? SelectedRepository { get; set; }
    private bool UseLocal => SelectedRepository is not null || Model?.GitHubUseCredentialManager == true || Model is null;
    private long? RepositoryId => SelectedRepository?.Id ?? Model?.GitHubRepositoryId;
    private string RepoOwner => SelectedRepository?.Owner ?? Model?.GitHub.RepoOwner ?? string.Empty;
    private string RepoName => SelectedRepository?.Name ?? Model?.GitHub.RepoName ?? string.Empty;
    private string ReturnPath => Model is null ? "/projects/new" : $"/projects/{Model.Id}/settings";
}

