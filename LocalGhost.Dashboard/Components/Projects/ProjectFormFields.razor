    .form-section>header p{color:#8b98ac}.form-field>small{color:#8e9aaf;font-size:9px}.form-field label em{color:#8793a8}.form-steps>a small{color:#748197}.steps-hint{color:#ada3c8}.switch-row span small{color:#7e8a9e}.enable-card small{color:#8e8291}.input-suffix span{color:#8490a4}.form-field input::placeholder,.form-field textarea::placeholder{color:#667287}.path-input-row{display:flex;align-items:stretch;gap:8px}.path-input-row>input{min-width:0;flex:1}.path-pick{min-width:88px;display:flex;align-items:center;justify-content:center;gap:6px;padding:0 12px;border:1px solid #3e3561;border-radius:8px;background:#24203a;color:#c4b5fd;cursor:pointer;font:600 9px inherit;transition:.15s}.path-pick:hover{border-color:#6d55af;background:#30284d;color:#ede9fe}.path-pick:disabled{cursor:wait;opacity:.65}.path-pick b{color:#a78bfa;font-size:12px}.path-spinner{width:11px;height:11px;border:2px solid #8878b4;border-top-color:#ede9fe;border-radius:50%;animation:pathSpin .7s linear infinite}.path-picker-toast{position:fixed;right:22px;bottom:22px;z-index:1000;max-width:390px;padding:11px 15px;border:1px solid #285749;border-radius:9px;background:#102d26;box-shadow:0 12px 30px #0007;color:#86efc0;font-size:10px}.path-picker-toast.error{border-color:#71343c;background:#30191d;color:#fda4af}@@keyframes pathSpin{to{transform:rotate(360deg)}}@@media(max-width:560px){.path-input-row{align-items:stretch;flex-direction:column}.path-pick{min-height:36px}}
